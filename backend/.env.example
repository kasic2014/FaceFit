# Spring profile: local, dev, prod
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Supabase PostgreSQL connection
DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-database-password

# Supabase Auth JWT issuer
SUPABASE_JWT_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1

# Supabase private Storage (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-secret-key
CAREER_DOCUMENTS_BUCKET=career-documents
JOB_POSTINGS_BUCKET=job-postings

# Private NCP Object Storage for new interview-answer videos only
INTERVIEW_ANSWER_STORAGE_PROVIDER=NCLOUD
NCLOUD_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCLOUD_OBJECT_STORAGE_REGION=kr-standard
NCLOUD_OBJECT_STORAGE_BUCKET=facefit-interview-videos
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
NCLOUD_PRESIGNED_GET_TTL_SECONDS=300

# Local Tesseract OCR for job postings
JOB_POSTING_OCR_ENABLED=true
TESSERACT_EXECUTABLE=tesseract
TESSDATA_PREFIX=
JOB_POSTING_OCR_LANGUAGES=kor+eng
JOB_POSTING_OCR_TIMEOUT_SECONDS=120
JOB_POSTING_HWP_TIMEOUT_SECONDS=30
JOB_POSTING_HWP_MAX_HEAP_MB=256

# Interview processing. Keep dispatch disabled until real AI/STT Ports are configured.
INTERVIEW_PROCESSING_DISPATCH_ENABLED=false
INTERVIEW_PROCESSING_RECOVERY_ENABLED=false
INTERVIEW_QUESTION_TIMEOUT_SECONDS=60
INTERVIEW_STT_TIMEOUT_SECONDS=120
INTERVIEW_ANALYSIS_TIMEOUT_SECONDS=60
INTERVIEW_REPORT_TIMEOUT_SECONDS=60
INTERVIEW_RECOVERY_INITIAL_DELAY_MS=10000
INTERVIEW_RECOVERY_DELAY_MS=10000

# Internal Python AI HTTP service. Inject the token through the deployment secret store.
FACEFIT_AI_BASE_URL=
FACEFIT_AI_SERVICE_TOKEN=
FACEFIT_AI_CONNECT_TIMEOUT=3s
FACEFIT_AI_RESPONSE_TIMEOUT=60s

# Flyway is the only schema migration mechanism.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0
