# =========================================================================
# FaceFit Environment Variables Template (.env.example)
#
# 이 파일을 복사하여 '.env' 파일을 생성하고, 실제 서버/로컬 환경 정보를 기입하십시오.
# *주의: 실제 정보가 담긴 '.env' 파일은 절대 깃허브에 커밋하지 마십시오.*
# =========================================================================

# Database Configuration (PostgreSQL)
# 예시: jdbc:postgresql://project-db-campus.smhrd.com:3310/your_db_name
DB_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_USERNAME=cgi_25is_ga3_p3_4
DB_PASSWORD=<YOUR_DATABASE_PASSWORD>

# Supabase Auth / Security
SUPABASE_JWT_ISSUER_URI=https://<YOUR_SUPABASE_PROJECT>.supabase.co/auth/v1

# Other optional configurations
# SERVER_PORT=8080
# FLYWAY_ENABLED=true
# DOMAIN=example.com
# BACKEND_HOST=backend
