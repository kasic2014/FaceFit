# FACE-FIT Docker Compose example values only.
# Copy this file to .env and replace every "replace-with-..." value locally.
# Never commit .env.

# Published host ports
BACKEND_PORT=8080
AI_SERVER_PORT=8001

# Spring Boot / external Supabase PostgreSQL
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://replace-with-supabase-db-host:5432/postgres?sslmode=require
DB_USERNAME=replace-with-database-user
DB_PASSWORD=replace-with-database-password
# Supabase public contains platform-managed objects before the first app migration.
# Use version 0 only after confirming that no Face Fit tables already exist.
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=0

# Supabase Auth and private Storage
SUPABASE_JWT_ISSUER_URI=https://replace-with-project-ref.supabase.co/auth/v1
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-or-service-role-key
CAREER_DOCUMENTS_BUCKET=career-documents
JOB_POSTINGS_BUCKET=job-postings

# New interview-answer videos only. Existing Supabase rows remain readable.
INTERVIEW_ANSWER_STORAGE_PROVIDER=NCLOUD
NCLOUD_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCLOUD_OBJECT_STORAGE_REGION=kr-standard
NCLOUD_OBJECT_STORAGE_BUCKET=facefit-interview-videos
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=
NCLOUD_PRESIGNED_GET_TTL_SECONDS=300

# Internal Spring Boot -> AI server authentication.
# Use a long random value. Compose sets FACEFIT_AI_BASE_URL internally to
# http://analysis-server:8001, so do not use localhost for container traffic.
FACEFIT_AI_SERVICE_TOKEN=replace-with-long-random-internal-token
FACEFIT_AI_CONNECT_TIMEOUT=3s
FACEFIT_AI_RESPONSE_TIMEOUT=60s

# Reproducible CPU defaults for the AI container
FACEFIT_AI_MODEL_TIMEOUT_SECONDS=55
FACEFIT_AI_MAX_UPLOAD_BYTES=209715200
ANALYSIS_MEDIA_ALLOWED_HOST=kr.object.ncloudstorage.com
ANALYSIS_MEDIA_CONNECT_TIMEOUT_SECONDS=5
ANALYSIS_MEDIA_READ_TIMEOUT_SECONDS=120
FACEFIT_AI_MAX_DURATION_SECONDS=300
FACEFIT_AI_TRANSCRIPT_MAX_CHARS=50000
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FACEFIT_CV_SAMPLE_FPS=2
FACEFIT_CV_MAX_SAMPLE_FRAMES=48
FACEFIT_CV_MIN_USABLE_FRAMES=5

# Development-safe worker defaults
JOB_POSTING_OCR_ENABLED=false
INTERVIEW_PROCESSING_DISPATCH_ENABLED=false
INTERVIEW_PROCESSING_RECOVERY_ENABLED=false
