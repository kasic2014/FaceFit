{
  "components": {
    "schemas": {
      "Body_analyze_cv_internal_v1_analyses_cv_post": {
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "media": {
            "contentMediaType": "application/octet-stream",
            "description": "MP4 or WebM answer media",
            "title": "Media",
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "media"
        ],
        "title": "Body_analyze_cv_internal_v1_analyses_cv_post",
        "type": "object"
      },
      "Body_analyze_stt_internal_v1_analyses_stt_post": {
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "language": {
            "pattern": "^ko$",
            "title": "Language",
            "type": "string"
          },
          "media": {
            "contentMediaType": "application/octet-stream",
            "description": "MP4 or WebM answer media",
            "title": "Media",
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "language",
          "media"
        ],
        "title": "Body_analyze_stt_internal_v1_analyses_stt_post",
        "type": "object"
      },
      "Body_analyze_voice_internal_v1_analyses_voice_post": {
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "media": {
            "contentMediaType": "application/octet-stream",
            "description": "MP4 or WebM answer media",
            "title": "Media",
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "media"
        ],
        "title": "Body_analyze_voice_internal_v1_analyses_voice_post",
        "type": "object"
      },
      "ContentAnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "jobContext": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jobcontext"
          },
          "question": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "transcript": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "question",
          "transcript"
        ],
        "title": "ContentAnalysisRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "MEDIA_ANALYSIS_FAILED",
              "MODEL_ERROR",
              "ANALYSIS_UNAVAILABLE",
              "MODEL_TIMEOUT"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "SttSuccessResponse": {
        "additionalProperties": false,
        "properties": {
          "analysisType": {
            "const": "STT",
            "default": "STT",
            "title": "Analysistype",
            "type": "string"
          },
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "durationSec": {
            "exclusiveMinimum": 0.0,
            "title": "Durationsec",
            "type": "number"
          },
          "language": {
            "const": "ko",
            "default": "ko",
            "title": "Language",
            "type": "string"
          },
          "modelVersion": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Modelversion",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schemaversion",
            "type": "string"
          },
          "transcript": {
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "answerId",
          "modelVersion",
          "transcript",
          "durationSec"
        ],
        "title": "SttSuccessResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AIServiceBearer": {
        "description": "Internal service token supplied through FACEFIT_AI_SERVICE_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Internal service-to-service analysis contract. CV, VOICE and CONTENT return ANALYSIS_UNAVAILABLE until their operational scoring contracts exist.",
    "title": "Face-Fit Analysis Server",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
