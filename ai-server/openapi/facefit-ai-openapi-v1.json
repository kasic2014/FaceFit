{
  "components": {
    "schemas": {
      "ContentAnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "jobContext": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Jobcontext"
          },
          "question": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "transcript": {
            "maxLength": 50000,
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "answerId",
          "question",
          "transcript"
        ],
        "title": "ContentAnalysisRequest",
        "type": "object"
      },
      "CvSuccessResponse": {
        "additionalProperties": false,
        "properties": {
          "analysisType": {
            "const": "CV",
            "default": "CV",
            "title": "Analysistype",
            "type": "string"
          },
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "feedback": {
            "items": {
              "type": "string"
            },
            "title": "Feedback",
            "type": "array"
          },
          "gazeScore": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Gazescore",
            "type": "number"
          },
          "modelVersion": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Modelversion",
            "type": "string"
          },
          "postureScore": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Posturescore",
            "type": "number"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schemaversion",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "answerId",
          "modelVersion",
          "gazeScore",
          "postureScore",
          "feedback"
        ],
        "title": "CvSuccessResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "MEDIA_ANALYSIS_FAILED",
              "MODEL_ERROR",
              "ANALYSIS_UNAVAILABLE",
              "MODEL_TIMEOUT"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requestid"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "MediaAnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "mediaMimeType": {
            "enum": [
              "video/mp4",
              "video/webm"
            ],
            "title": "Mediamimetype",
            "type": "string"
          },
          "mediaSizeBytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 209715200.0,
            "title": "Mediasizebytes",
            "type": "integer"
          },
          "mediaUrl": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Mediaurl",
            "type": "string"
          },
          "recordedDurationSec": {
            "exclusiveMinimum": 0.0,
            "maximum": 300.0,
            "title": "Recordeddurationsec",
            "type": "number"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1",
            "title": "Schemaversion",
            "type": "string"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "answerId",
          "mediaUrl",
          "mediaMimeType",
          "mediaSizeBytes",
          "recordedDurationSec"
        ],
        "title": "MediaAnalysisRequest",
        "type": "object"
      },
      "SttSuccessResponse": {
        "additionalProperties": false,
        "properties": {
          "analysisType": {
            "const": "STT",
            "default": "STT",
            "title": "Analysistype",
            "type": "string"
          },
          "answerId": {
            "format": "uuid",
            "title": "Answerid",
            "type": "string"
          },
          "durationSec": {
            "exclusiveMinimum": 0.0,
            "title": "Durationsec",
            "type": "number"
          },
          "language": {
            "const": "ko",
            "default": "ko",
            "title": "Language",
            "type": "string"
          },
          "modelVersion": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Modelversion",
            "type": "string"
          },
          "requestId": {
            "format": "uuid",
            "title": "Requestid",
            "type": "string"
          },
          "schemaVersion": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schemaversion",
            "type": "string"
          },
          "transcript": {
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "answerId",
          "modelVersion",
          "transcript",
          "durationSec"
        ],
        "title": "SttSuccessResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AIServiceBearer": {
        "description": "Internal service token supplied through FACEFIT_AI_SERVICE_TOKEN.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Internal service-to-service analysis contract. CV uses a bounded CPU landmark pipeline. VOICE and CONTENT return ANALYSIS_UNAVAILABLE until their operational contracts exist.",
    "title": "Face-Fit Analysis Server",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/v1/analyses/content": {
      "post": {
        "operationId": "analyze_content_internal_v1_analyses_content_post",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service authentication failed"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Media limit exceeded"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Content-Type or media"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Media could not be analyzed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Model execution failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Model execution timed out"
          }
        },
        "security": [
          {
            "AIServiceBearer": []
          }
        ],
        "summary": "Content contract endpoint (model and rubric unavailable)",
        "tags": [
          "internal-analyses"
        ]
      }
    },
