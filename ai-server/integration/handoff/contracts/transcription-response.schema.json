{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "pattern": "^ANS_\\d{6}$",
            "type": "string"
          },
          "language": {
            "additionalProperties": true,
            "type": "object"
          },
          "segmentCount": {
            "minimum": 0,
            "type": "integer"
          },
          "segments": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "endMsSession": {
                  "minimum": 1,
                  "type": "integer"
                },
                "startMsSession": {
                  "minimum": 0,
                  "type": "integer"
                },
                "text": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "startMsSession",
                "endMsSession",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "textExposed": {
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "answerId": {
                  "anyOf": [
                    {
                      "pattern": "^ANS_\\d{6}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code": {
                  "minLength": 1,
                  "type": "string"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                },
                "reviewRequired": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "answerId",
                "reviewRequired"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "wordCount": {
            "minimum": 0,
            "type": "integer"
          },
          "words": {
            "items": {
              "additionalProperties": true,
              "properties": {
                "endMsSession": {
                  "minimum": 1,
                  "type": "integer"
                },
                "startMsSession": {
                  "minimum": 0,
                  "type": "integer"
                },
                "text": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "startMsSession",
                "endMsSession",
                "text"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "answerId",
          "status",
          "language",
          "textExposed",
          "text",
          "segmentCount",
          "wordCount",
          "segments",
          "words",
          "warnings"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "engine": {
      "additionalProperties": true,
      "type": "object"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "options": {
      "additionalProperties": true,
      "type": "object"
    },
    "sessionId": {
      "pattern": "^SES_\\d{6}$",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "type": "string"
    },
    "warnings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "anyOf": [
              {
                "pattern": "^ANS_\\d{6}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "reviewRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "answerId",
          "reviewRequired"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "sessionId",
    "status",
    "engine",
    "options",
    "answers",
    "warnings",
    "errors"
  ],
  "title": "Transcription Response",
  "type": "object"
}
