# Python virtual environments
.venv/
**/.venv/

# Python caches and compiled files
**/__pycache__/
**pycache**/
*.py[cod]

# Environment and log files
.env
.env.*
!**/.env.docker.example
*.log

# AI model files
models/
*.pt
*.pth
*.onnx
*.bin
*.safetensors

# User media, analysis output, temporary data, and logs
ai-server/**/data/input/*
!ai-server/**/data/input/*/
!ai-server/**/data/input/**/
ai-server/analysis-server/data/input/audio/raw/*
ai-server/analysis-server/data/input/audio/standard/*
ai-server/analysis-server/data/input/audio/transcripts/*.txt
ai-server/**/data/output/*
ai-server/**/data/temp/*
ai-server/tts-server/data/reference_voice/*
ai-server/**/logs/*

# Keep empty directory placeholders
!**/.gitkeep

# IDE personal settings (keep shared workspace settings)
.vscode/*
!.vscode/settings.json
.idea/
*.code-workspace

# Operating-system temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
~$*
